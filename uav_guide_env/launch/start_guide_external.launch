<launch>
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 内部可视化（对接运行中的节点）：仅启动 rviz 可视化节点       -->
    <!--                                                           -->
    <!-- 说明：当前架构下，uav_guide（主循环）、udp_receiver、       -->
    <!--       udp_sender、udp_mssn_bridge（发射距离判断）等节点已由   -->
    <!--       udp_mssn_bridge.launch 通过 tmux 依次启动。           -->
    <!--       为避免重复开启节点，本 launch 不再 include            -->
    <!--       uav_guide.launch / uav_bridge.launch（不启动          -->
    <!--       udp_mssn_bridge 发射距离计算），只启动可视化：        -->
    <!--       1. rviz_publisher：订阅 /uav/state、/target/state、   -->
    <!--          /uav/planned_path、/beam_dubins/origin_pos，发布   -->
    <!--          uav/target 球体+箭头 Marker                       -->
    <!--       2. rviz：灰黑底色、视图中心在全局原点，默认显示上述元素 -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- 1. 空间参数 + rviz_publisher（订阅 /uav/state、/target/state、/uav/planned_path、/beam_dubins/origin_pos） -->
    <rosparam ns="space" param="lx">10000.0</rosparam>
    <rosparam ns="space" param="ly">5000.0</rosparam>
    <rosparam ns="space" param="lz">1000.0</rosparam>
    <rosparam ns="space" param="boundary_margin">50.0</rosparam>
    <node name="rviz_publisher" pkg="uav_guide_env" type="rviz_publisher" output="screen">
      <rosparam ns="simulation" param="uav_state_topic">/uav/state</rosparam>
    </node>

    <!-- 2. Rviz（灰黑底色、视图中心在全局原点，默认显示 uav/target 球体+箭头、规划路径等） -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find uav_guide_env)/config/rviz/beam_dubins_3d.rviz"
          required="false"/>
</launch>
