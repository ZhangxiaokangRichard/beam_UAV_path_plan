<launch>
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 真实 target 内部 rviz 仿真（阶段 7b）                      -->
    <!--                                                           -->
    <!-- 数据流：                                                  -->
    <!--   现场 → UDP → udp_receiver → /target/state(真实)          -->
    <!--        → target_publisher(EXTERNAL) → /target/virtual_goal -->
    <!--        → simulation_loop(use_dynamics 控制律驱动) → rviz    -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- 1. 算法层：beam_dubins 规划服务 -->
    <include file="$(find beam_dubins)/launch/planner.launch"/>

    <!-- 2. UDP 桥：提供真实 /target/state, /uav/state（ros_udp_bridge） -->
    <include file="$(find ros_udp_bridge)/launch/udp_bridge.launch"/>

    <!-- 3. 运动解算服务 /uav_dynamic/solve -->
    <include file="$(find uav_dynamic)/launch/uav_dynamic.launch"/>

    <!-- 4. 目标节点：EXTERNAL 模式（订阅真实 /target/state → virtual_goal/intercept_mode） -->
    <rosparam file="$(find uav_guide_env)/config/target_trajectory.yaml" command="load" ns="target"/>
    <rosparam ns="target" param="external_target">true</rosparam>
    <node name="target_publisher" pkg="uav_guide_env" type="target_publisher" output="screen"/>

    <!-- 5. 环境参数 -->
    <rosparam file="$(find uav_guide_env)/config/uav_dynamics.yaml" command="load" ns="uav"/>
    <rosparam file="$(find uav_guide_env)/config/scenario.yaml" command="load" ns="scenario"/>
    <rosparam ns="space" param="lx">10000.0</rosparam>
    <rosparam ns="space" param="ly">5000.0</rosparam>
    <rosparam ns="space" param="lz">1000.0</rosparam>
    <rosparam ns="space" param="boundary_margin">50.0</rosparam>
    <rosparam ns="simulation" param="dt">0.05</rosparam>
    <rosparam ns="simulation" param="use_dynamics">true</rosparam>

    <!-- 6. 可视化 + 仿真主循环 -->
    <node name="rviz_publisher" pkg="uav_guide_env" type="rviz_publisher" output="screen"/>
    <node name="simulation_loop" pkg="uav_guide_env" type="simulation_loop" output="screen"/>

    <!-- 7. Rviz 3D 可视化 -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find uav_guide_env)/config/rviz/beam_dubins_3d.rviz"
          required="false"/>
</launch>
