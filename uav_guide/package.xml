<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_guide</name>
  <version>2.0.0</version>
  <description>
    UAV 制导（ROS2 Humble，C++17）。三个节点全权分布式：
    uav_guide_loop_node（规划）→ aoa/uav/planed_path；
    uav_guide_point_node（指点制导）→ aoa/uav/setpoint；
    uav_guidance_node（巡航制导）→ aoa/uav/guidance。
    算法层（uav_guide::*）零 ROS 依赖。
  </description>

  <maintainer email="ros-dev@example.com">ros-dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>beam_dubins</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
